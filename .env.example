# ChangeLoop Water Intelligence — Environment Configuration Template
# Copy this file to .env.local for local server deployment.
# Never commit .env or .env.local to source control.

# Server binding
HOST=0.0.0.0
PORT=8000

# Cryptographic Ledger HMAC-SHA256 Signing Key (64-character hex or secure passphrase)
# If left unset in development, the built-in demonstration key is used and disclosed in the UI.
CHANGELOOP_LEDGER_KEY=

# Persistent Data Storage Path (defaults to ./data)
# On cloud platforms like Render, point to persistent mounted disk if available.
CHANGELOOP_DATA_DIR=

# Security & CORS settings
CHANGELOOP_ENV=production
ALLOWED_ORIGINS=https://changeloop-water-intelligence.onrender.com
